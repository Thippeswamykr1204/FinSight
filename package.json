{
  "name": "finsight",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "next dev --turbopack",
    "dev:hosted": "node scripts/hosted.mjs dev",
    "db:hosted:local": "node scripts/hosted.mjs setup",
    "test:hosted": "node scripts/hosted.mjs test",
    "worker:email": "tsx scripts/email-worker.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:email:production": "node dist/email-worker.cjs",
    "env:init": "node scripts/init-env.mjs",
    "test:container": "node scripts/container-smoke.mjs",
    "build": "npm run db:generate && next build && npm run worker:build",
    "start": "node scripts/start.mjs",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run db:generate && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs}' '*.{json,js,ts,mts}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs}' '*.{json,js,ts,mts}'",
    "db:generate": "prisma generate && prisma generate --schema prisma/hosted/schema.prisma",
    "db:hosted:migrate": "prisma migrate deploy --schema prisma/hosted/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.344.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.14",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "react-qr-code": "^2.2.0",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^8",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.1",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
