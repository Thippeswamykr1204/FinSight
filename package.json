{
  "name": "finsight",
  "version": "2.0.0",
  "private": true,
  "description": "India-first personal finance workspace with integer-paise accounting and secure multi-tenant MongoDB storage.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "author": "Thippeswamy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thippeswamykr1204/FinSight.git"
  },
  "homepage": "https://finsight-five-delta.vercel.app",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "typescript",
    "mongodb",
    "mongoose",
    "fintech",
    "personal-finance",
    "india",
    "pwa",
    "better-auth",
    "playwright"
  ],
  "scripts": {
    "predev": "npm run shared:build",
    "dev": "next dev --turbopack",
    "dev:web": "npm run dev --workspace @finsight/web",
    "dev:api": "npm run dev --workspace @finsight/api",
    "dev:hosted": "concurrently -k \"npm run dev:api\" \"npm run dev\"",
    "api:start": "npm run start --workspace @finsight/api",
    "api:test": "npm run test --workspace @finsight/api",
    "shared:build": "npm run build --workspace @finsight/shared",
    "shared:test": "npm run test --workspace @finsight/shared",
    "env:init": "node scripts/init-env.mjs",
    "db:migrate:postgres-to-mongo": "tsx scripts/migrate-postgres-to-mongo.ts",
    "db:seed": "tsx scripts/seed.ts",
    "build": "npm run shared:build && next build && npm run build --workspace @finsight/api",
    "start": "node scripts/start.mjs",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "npm run shared:build && tsc -p tsconfig.typecheck.json --noEmit --incremental false && npm run typecheck --workspace @finsight/api",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:api": "npm run test --workspace @finsight/api",
    "test:integration": "npm run test:integration --workspace @finsight/api",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:api && npm run test:integration && npm run build",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'apps/**/*.{ts,tsx,css,json}' 'packages/**/*.{ts,tsx,json}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs}' '*.{json,js,ts,mts}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'apps/**/*.{ts,tsx,css,json}' 'packages/**/*.{ts,tsx,json}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs}' '*.{json,js,ts,mts}'"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "esbuild": "^0.28.2",
    "source-map-js": "^1.2.2"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "@better-auth/passkey": "^1.7.7",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "bullmq": "^5.58.5",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.344.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.14",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "pg": "^8.16.3",
    "react": "^18",
    "react-dom": "^18",
    "react-qr-code": "^2.2.0",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pino-http": "^5.8.4",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.2.1",
    "testcontainers": "^11.7.2",
    "autoprefixer": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^8",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.1",
    "supertest": "^7.1.4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
