{
  "name": "finsight",
  "version": "3.0.0",
  "private": true,
  "description": "India-first personal finance workspace with integer-paise accounting and secure multi-tenant MongoDB storage.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "author": "Thippeswamy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thippeswamykr1204/FinSight.git"
  },
  "homepage": "https://finsight-five-delta.vercel.app",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "typescript",
    "mongodb",
    "mongoose",
    "fintech",
    "personal-finance",
    "india",
    "pwa",
    "better-auth",
    "playwright"
  ],
  "scripts": {
    "predev": "npm run shared:build",
    "dev": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev apps/web --turbopack",
    "dev:web": "npm run dev --workspace @finsight/web",
    "dev:api": "npm run dev --workspace @finsight/api",
    "dev:hosted": "concurrently -k \"npm run dev:api\" \"npm run dev\"",
    "api:start": "npm run start --workspace @finsight/api",
    "api:test": "npm run test --workspace @finsight/api",
    "shared:build": "npm run build --workspace @finsight/shared",
    "shared:test": "vitest run tests/unit/finance.test.ts tests/unit/india.test.ts tests/unit/planning.test.ts",
    "env:init": "node scripts/init-env.mjs",
    "preflight": "node --import tsx scripts/preflight.mts",
    "fields:rekey": "node --env-file-if-exists=.env --import tsx scripts/rekey.mts",
    "build": "npm run shared:build && npm run build --workspace @finsight/web && npm run build --workspace @finsight/api",
    "start": "node scripts/start.mjs",
    "lint": "eslint apps/web/src apps/api/src packages/shared/src --max-warnings=0",
    "typecheck": "npm run shared:build && npm run typecheck --workspace @finsight/web && npm run typecheck --workspace @finsight/api && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/e2e.mts",
    "test:api": "npm run test --workspace @finsight/api",
    "test:api:coverage": "npm run test:coverage --workspace @finsight/api",
    "test:integration": "npm run test:integration --workspace @finsight/api",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:api:coverage && npm run test:integration && npm run build",
    "format": "prettier --write 'apps/**/*.{ts,tsx,css,json,js,mts}' 'packages/**/*.{ts,tsx,json}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs,mts}' '*.{json,js,ts,mts,yaml}'",
    "format:check": "prettier --check 'apps/**/*.{ts,tsx,css,json,js,mts}' 'packages/**/*.{ts,tsx,json}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs,mts}' '*.{json,js,ts,mts,yaml}'"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "esbuild": "^0.28.2",
    "source-map-js": "^1.2.2",
    "shell-quote": "^1.12.0",
    "glob": "^10.5.0",
    "@next/eslint-plugin-next": "14.2.35"
  },
  "dependencies": {
    "@sentry/node": "^11.5.0",
    "@sentry/nextjs": "^11.5.0",
    "argon2": "^0.44.0",
    "@better-auth/passkey": "^1.7.7",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "bullmq": "^5.58.5",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.344.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.14",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "react": "^18",
    "react-dom": "^18",
    "react-qr-code": "^2.2.0",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.2.1",
    "testcontainers": "^12.2.0",
    "autoprefixer": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^8",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "tsx": "^4.7.1",
    "supertest": "^7.1.4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
