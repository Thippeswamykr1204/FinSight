{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@finsight/shared": ["packages/shared/src/index.ts"],
      "@finsight/shared/*": ["packages/shared/src/*"],
      "@/*": ["apps/web/src/*"]
    }
  },
  "include": ["scripts/**/*.mts"]
}
