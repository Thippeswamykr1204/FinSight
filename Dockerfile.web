FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY *.json *.js *.mjs *.mts *.ts ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline --no-audit --fund=false

FROM deps AS build
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG BUILD_STANDALONE=true
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL} BUILD_STANDALONE=${BUILD_STANDALONE} NEXT_TELEMETRY_DISABLED=1 HOSTED_ENABLED=false
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 TZ=Asia/Kolkata
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
