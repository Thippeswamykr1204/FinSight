FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY *.json *.js *.mjs *.mts *.ts ./
RUN --mount=type=cache,target=/root/.npm npm ci --prefer-offline --no-audit --fund=false

FROM deps AS build
RUN npm run build --workspace @finsight/api

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production TZ=Asia/Kolkata
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
USER node
EXPOSE 4000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+process.env.API_PORT+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/index.js"]
