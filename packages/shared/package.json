{
  "name": "@finsight/shared",
  "version": "3.0.0",
  "private": true,
  "description": "Shared India-first finance contracts and deterministic calculations.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./finance/*": {
      "types": "./dist/finance/*.d.ts",
      "import": "./dist/finance/*.js",
      "default": "./dist/finance/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
