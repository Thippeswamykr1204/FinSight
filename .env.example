# The browser-local v2 demo runs with npm run dev and needs no secrets.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Legacy single-user API is disabled by default; not a SaaS backend.
ENABLE_LEGACY_API="false"
DATABASE_URL="postgresql://finsight:local_dev_only@localhost:5432/finsight"
DIRECT_URL="postgresql://finsight:local_dev_only@localhost:5432/finsight"
REDIS_URL="redis://localhost:6379"
APP_PASSWORD=""
# Generate with: openssl rand -base64 48
AUTH_SECRET=""
