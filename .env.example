# FinSight 3 · local demo and hosted MERN configuration
# Copy to .env.local for the web and API. Never commit real values.

# Web (Next.js/Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
HOSTED_ENABLED="false"
NEXT_TELEMETRY_DISABLED="1"
HOSTNAME="0.0.0.0"
PORT="3000"
TZ="Asia/Kolkata"

# API (Express)
NODE_ENV="development"
API_HOST="0.0.0.0"
API_PORT="4000"
API_ORIGIN="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
MONGODB_URI="mongodb://localhost:27017/finsight?replicaSet=rs0"
REDIS_URL="redis://localhost:6379"
BETTER_AUTH_SECRET=""
# 32 random bytes encoded as 64 hex characters; separate from BETTER_AUTH_SECRET.
FIELD_ENCRYPTION_KEY=""
HOSTED_LOCAL="true"
TRUSTED_PROXY=""
LOG_LEVEL="info"

# SMTP / BullMQ email worker
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="FinSight Local <hello@finsight.local>"

# Public hosted launch metadata (required when NODE_ENV=production and HOSTED_LOCAL=false)
PRIVACY_CONTACT_EMAIL=""
GRIEVANCE_OFFICER_NAME=""

# Optional OAuth provider credentials. Buttons stay hidden when incomplete.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Compose ports/images
FINSIGHT_WEB_PORT="3000"
FINSIGHT_API_PORT="4000"
FINSIGHT_MONGO_PORT="27017"
FINSIGHT_REDIS_PORT="6379"
FINSIGHT_SMTP_PORT="1025"
FINSIGHT_SMTP_UI_PORT="8025"
FINSIGHT_IMAGE="finsight-web:local"
