# DEMO: no environment file is needed. HOSTED: use your secret manager or
# npm run env:init -- --mode hosted --output .local/production.env (local smoke).
# Never put real credentials in this template. All URLs below are local defaults.

# Optional, build-time public origin (metadata/sitemap); production: your HTTPS domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional mode switch; false = browser-local demo, true = database workspaces.
HOSTED_ENABLED="false"
# Required in hosted mode. Use a PostgreSQL DSN; production needs TLS outside private networks.
# Compose fills this from POSTGRES_PASSWORD if blank. Managed DB: obtain from provider console.
HOSTED_DATABASE_URL=""
# Required in hosted mode; HTTPS origin in production, matching NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL="http://localhost:3000"
# Required in hosted mode, >=32 chars. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=""
# Required in hosted mode: SMTP host and verified sender. Port optional (587).
SMTP_HOST=""
SMTP_PORT="587"
# Optional authenticated SMTP pair. Provider issues these; if user is set, password is required.
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
# Optional local test escape hatch; only loopback origins permitted. Never true on a public host.
HOSTED_LOCAL="false"
# Optional proxy-overwritten SINGLE-IP header, e.g. x-real-ip. Empty = shared fallback bucket.
TRUSTED_IP_HEADER=""
# Required for public hosted production: real operator privacy contact and grievance officer.
PRIVACY_CONTACT_EMAIL=""
GRIEVANCE_OFFICER_NAME=""
# Optional OAuth pairs from provider consoles. Adapters not live-verified; signup consent is required.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Optional production container settings. Defaults are shown; Docker sets NODE_ENV itself.
BUILD_STANDALONE="false"
NEXT_TELEMETRY_DISABLED="1"
HOSTNAME="0.0.0.0"
PORT="3000"
TZ="Asia/Kolkata"
FINSIGHT_PORT="3000"
FINSIGHT_IMAGE="finsight:local"
# Required for Compose hosted Postgres; generate with openssl rand -hex 32.
POSTGRES_PASSWORD=""
# Optional Redis profile, reserved for disabled legacy cache; generate independently.
REDIS_PASSWORD=""

# Legacy-only. Disabled by default and rejected at public hosted production boot.
# DATABASE_URL/DIRECT_URL: legacy Prisma DSNs, not the hosted ledger.
# REDIS_URL: optional legacy cache DSN; APP_PASSWORD: operator password.
# AUTH_SECRET: legacy signing secret, generate independently with openssl rand -base64 48.
ENABLE_LEGACY_API="false"
DATABASE_URL=""
DIRECT_URL=""
REDIS_URL=""
APP_PASSWORD=""
AUTH_SECRET=""
