# FinSight · Next.js, Express, MongoDB and Redis
# Run npm run env:init to create .env. Never commit real values.

# Web (Next.js/Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
NEXT_TELEMETRY_DISABLED="1"
HOSTNAME="0.0.0.0"
PORT="3000"
TZ="Asia/Kolkata"

# API (Express)
NODE_ENV="development"
API_HOST="0.0.0.0"
API_PORT="4000"
API_ORIGIN="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
MONGODB_URI="mongodb://localhost:27017/finsight?replicaSet=rs0"
REDIS_URL="redis://localhost:6379"
BETTER_AUTH_SECRET=""
# 32 random bytes encoded as 64 hex characters; separate from BETTER_AUTH_SECRET.
FIELD_ENCRYPTION_KEY=""
# JSON array of retained old keys during rotation; never commit values.
FIELD_ENCRYPTION_PREVIOUS_KEYS="[]"
HOSTED_LOCAL="true"
TRUSTED_PROXY=""
LOG_LEVEL="info"
# Explicit proxy address/subnet allowlist, e.g. loopback behind a local TLS proxy.
# The ingress must overwrite untrusted X-Forwarded-For headers.

# Optional redacted server error monitoring; no financial payloads are sent.
SENTRY_DSN=""
SENTRY_RELEASE=""

# SMTP / BullMQ email worker
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="FinSight Local <hello@finsight.local>"

# Public hosted launch metadata (required when NODE_ENV=production and HOSTED_LOCAL=false)
PRIVACY_CONTACT_EMAIL=""
GRIEVANCE_OFFICER_NAME=""

# Optional Google OAuth credentials; both are required to enable the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional subscriptions. Leave ALL blank for Free-only operation.
# Configure monthly INR plans: Pro 35282 paise, Business 94282 paise (18% GST included).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Retain the previous secret while older webhook deliveries may be retried.
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=""
RAZORPAY_PRO_PLAN_ID=""
RAZORPAY_BUSINESS_PLAN_ID=""
BILLING_BUSINESS_NAME=""
BILLING_BUSINESS_ADDRESS=""
BILLING_GSTIN=""
BILLING_STATE_CODE=""
# Operator's six-digit service accounting code.
BILLING_SAC=""

# Compose ports/images
FINSIGHT_WEB_PORT="3000"
FINSIGHT_API_PORT="4000"
FINSIGHT_MONGO_PORT="27017"
FINSIGHT_REDIS_PORT="6379"
FINSIGHT_SMTP_PORT="1025"
FINSIGHT_SMTP_UI_PORT="8025"
FINSIGHT_IMAGE="finsight-web:local"
