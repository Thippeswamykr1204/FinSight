{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "noEmit": false,
    "noEmitOnError": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "plugins": [],
    "baseUrl": "../..",
    "paths": {
      "@finsight/shared": ["packages/shared/dist/index.d.ts"],
      "@finsight/shared/*": ["packages/shared/dist/finance/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts"]
}
