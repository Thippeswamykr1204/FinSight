# Hosted mode is separate from the legacy DATABASE_URL configuration.
# For local development, npm run dev:hosted sets these safely and starts dependencies.
HOSTED_ENABLED="false"
HOSTED_DATABASE_URL="postgresql://finsight_local:local_development_only@127.0.0.1:55432/finsight_hosted_local"
BETTER_AUTH_URL="http://localhost:3000"
# Supply a generated secret of at least 32 characters outside local development.
BETTER_AUTH_SECRET=""
SMTP_HOST="127.0.0.1"
SMTP_PORT="11025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="FinSight <hello@finsight.local>"
# Local-only: disables SMTP TLS requirements. Never use for a public deployment.
HOSTED_LOCAL="false"
# Optional trusted ingress header. The proxy must overwrite this; never trust clients.
TRUSTED_IP_HEADER=""
# OAuth buttons appear only when both variables for that provider are configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
